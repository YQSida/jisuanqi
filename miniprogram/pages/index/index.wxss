    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 6px 16px;
    border-radius: 16px;
    font-size: calc(0.95rem * var(--font-scale));
    transition: all 0.3s;
}
.unit-toggle-new .unit-btn.active {
    background: white;
    color: var(--primary-color);
    font-weight: bold;
    box-shadow: var(--shadow-sm);
}

/* === 弹窗 === */
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.modal-overlay.active {
    animation: fadeIn 0.2s;
}
.modal-card {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 400px;
    padding: 24px;
    box-shadow: var(--shadow-md);
    animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes slideUp {
    from { transform: translateY(30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
.modal-title {
    font-size: calc(1.3rem * var(--font-scale));
    font-weight: bold;
    margin-bottom: 20px;
    text-align: center;
}
.modal-input {
    width: 100%;
    height: 50px;
    font-size: calc(1.5rem * var(--font-scale));
    padding: 0 12px;
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    text-align: center;
    margin-bottom: 20px;
    box-sizing: border-box;
}
.modal-actions {
    display: flex;
    gap: 15px;
}
.modal-btn {
    flex: 1;
    padding: 14px;
    border-radius: var(--radius-md);
    font-size: calc(1.1rem * var(--font-scale));
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}
.modal-btn-cancel {
    background: #F1F5F9;
    color: var(--text-main);
}
.modal-btn-danger {
    background: var(--danger-color);
    color: white;
}
.modal-btn-confirm {
    background: var(--primary-color);
    color: white;
}

/* === 云端同步 Loading === */
.cloud-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255,255,255,0.9);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.loading-spinner {
    width: 50px;
    height: 50px;
    border: 5px solid #f3f3f3;
    border-top: 5px solid var(--primary-color);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 20px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.loading-text {
    font-size: 1.1rem;
    color: var(--text-color);
    font-weight: 500;
}

/* === 新手引导教程样式 === */
.guide-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: transparent;
    z-index: 9990;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none; /* 容器不拦截，由 mask 面板拦截点击 */
}
.guide-overlay.active {
    opacity: 1;
}
/* 兜底全屏遮罩：目标元素 rect 尚未算出时显示，避免初始无遮罩 */
.guide-mask-full {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 9990;
    pointer-events: auto;
}
/* 4 块拼接半透明遮罩，中间镂空高亮区 */
.guide-mask-panel {
    position: fixed;
    background: rgba(0, 0, 0, 0.65);
    z-index: 9990;
    pointer-events: auto;
}
.guide-highlight {
    position: fixed;
    z-index: 9991;
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
    border: 2px dashed var(--accent-color);
    box-sizing: border-box;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.4); /* 仅高亮框外发光，挖洞由 4 块拼接负责 */
}
.guide-tooltip {
    position: fixed;
    z-index: 9992;
    background: var(--card-bg);
    color: var(--text-main);
    padding: 16px 20px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md), 0 10px 30px rgba(0,0,0,0.15);
    width: 290px;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    font-size: calc(0.95rem * var(--font-scale));
    box-sizing: border-box;
    transform: scale(0.95);
    opacity: 0;
    pointer-events: auto; /* 显式恢复气泡内部的点击响应 */
}
.guide-overlay.active .guide-tooltip {
    transform: scale(1);
    opacity: 1;
}
.guide-tooltip-title {
    font-weight: bold;
    font-size: calc(1.1rem * var(--font-scale));
    margin-bottom: 8px;
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.guide-voice-btn {
    font-size: calc(1.2rem * var(--font-scale));
    padding: 2px 6px;
    background: #F1F5F9;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.guide-voice-btn:active {
    background: #E2E8F0;
}
.guide-tooltip-content {
    line-height: 1.5;
    margin-bottom: 15px;
    color: var(--text-main);
}
.guide-tooltip-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.guide-btn {
    padding: 8px 14px;
    border-radius: 20px;
    font-size: calc(0.85rem * var(--font-scale));
    font-weight: bold;
    text-align: center;
    transition: all 0.2s;
}
.guide-btn-primary {
    background: var(--primary-color);
    color: white;
}
.guide-btn-primary:active {
    background: var(--primary-light);
}
.guide-btn-text {
    color: var(--text-muted);
}
.guide-btn-text:active {
    background: #F1F5F9;
}
.guide-step-indicator {
    font-size: calc(0.85rem * var(--font-scale));
    color: var(--text-muted);
    font-weight: 500;
}

/* === 设置弹窗新增字段样式 === */
.settings-input-field {
    width: 100%;
    height: 42px;
    background: #F8FAFC;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0 12px;
    font-size: calc(0.95rem * var(--font-scale));
    color: var(--text-main);
    box-sizing: border-box;
}

/* === 电子小票弹窗与画布样式 === */
.receipt-modal-overlay {
    padding: 16px 12px;
    z-index: 10000;
}
.receipt-modal-card {
    background: #FFFFFF;
    border-radius: 20px;
    width: 100%;
    max-width: 380px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    padding: 18px 16px 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
    animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-sizing: border-box;
}
.receipt-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}
.receipt-title-box {
    display: flex;
    align-items: center;
    gap: 6px;
}
.receipt-title-icon {
    font-size: 1.3rem;
}
.receipt-title-text {
    font-size: calc(1.15rem * var(--font-scale));
    font-weight: bold;
    color: var(--primary-color);
}
.receipt-modal-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #F1F5F9;
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: bold;
}
.receipt-modal-close:active {
    background: #E2E8F0;
}
.receipt-sub-tip {
    font-size: calc(0.8rem * var(--font-scale));
    color: #047857;
    background: #ECFDF5;
    padding: 6px 10px;
    border-radius: 8px;
    margin-bottom: 12px;
    text-align: center;
}
.receipt-scroll-container {
    flex: 1;
    max-height: 56vh;
    overflow-y: auto;
    border-radius: 12px;
    background: #F1F5F9;
    padding: 12px 10px;
    box-sizing: border-box;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.06);
}
.receipt-paper-wrapper {
    display: flex;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(0,0,0,0.12);
    border-radius: 4px;
    overflow: hidden;
    background: #FFFFFF;
}
.receipt-preview-img {
    width: 100%;
    display: block;
}
.receipt-modal-footer {
    display: flex;
    gap: 8px;
    margin-top: 14px;
}
.receipt-btn {
    flex: 1;
    height: 44px;
    line-height: 44px;
    border-radius: 22px;
    font-size: calc(0.85rem * var(--font-scale));
    font-weight: bold;
    text-align: center;
    padding: 0 6px;
    margin: 0;
    border: none;
    box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
}
.receipt-btn::after {
    border: none;
}
.receipt-btn-preview {
    background: #F1F5F9;
    color: var(--text-main);
    border: 1px solid #CBD5E1;
}
.receipt-btn-preview:active {
    background: #E2E8F0;
}
.receipt-btn-save {
    background: var(--primary-color);
    color: #FFFFFF;
}
.receipt-btn-save:active {
    background: var(--primary-light);
}
.receipt-btn-share {
    background: #10B981;
    color: #FFFFFF;
}
.receipt-btn-share:active {
    background: #059669;
}
.receipt-offscreen-canvas {
    position: fixed;
    left: -9999px;
    top: -9999px;
    pointer-events: none;
    opacity: 0;
}
