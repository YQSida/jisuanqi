.container {
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    box-sizing: border-box;
}

/* === 头部 === */
.header {
    background: var(--primary-color);
    color: white;
    padding: 20px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 0;
    z-index: 100;
}
.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.app-title {
    font-size: calc(1.2rem * var(--font-scale));
    font-weight: 600;
    letter-spacing: 1px;
}
.unit-toggle {
    background: rgba(255,255,255,0.2);
    border-radius: 20px;
    display: flex;
    padding: 4px;
}
.unit-btn {
    background: transparent;
    border: none;
    color: white;
    padding: 6px 16px;
    border-radius: 16px;
    font-size: calc(0.95rem * var(--font-scale));
    transition: all 0.3s;
}
.unit-btn.active {
    background: white;
    color: var(--primary-color);
    font-weight: bold;
}
.stats {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
}
.stat-item {
    display: flex;
    flex-direction: column;
}
.stat-label {
    font-size: calc(0.9rem * var(--font-scale));
    color: var(--text-muted);
    margin-bottom: 4px;
}
.stat-value {
    font-size: calc(2.2rem * var(--font-scale));
    font-weight: bold;
    color: var(--primary-color);
}
.history-stats-card {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    padding: 20px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 20px;
    border-left: 5px solid var(--accent-color);
}

/* === 页面内容�?=== */
.page-content {
    display: none;
    padding: 15px;
    flex: 1;
    animation: fadeIn 0.3s ease;
}
.page-content.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* === 并发顾客标签 === */
/* === 顶部分类栏与操作按钮 === */
.top-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    background-color: var(--bg-color);
    z-index: 90;
    padding: 6px 10px 8px 10px;
    box-sizing: border-box;
    width: 100%;
    max-width: 100vw;
}
.customer-tabs {
    display: flex;
    gap: 6px;
    flex: 1 1 0%;
    min-width: 0;
    width: 0;
    overflow: hidden;
}
.customer-tabs::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
    color: transparent;
}
.nav-right-actions {
    display: flex;
    gap: 6px;
    margin-left: 6px;
    flex-shrink: 0;
}
.tab-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 50px;
    height: 34px;
    padding: 0 11px;
    background: #E8EFEA;
    color: #475569;
    border-radius: 17px;
    font-weight: 600;
    font-size: calc(0.85rem * var(--font-scale));
    position: relative;
    transition: all 0.2s;
    flex-shrink: 0;
}
.tab-item.active {
    background: linear-gradient(135deg, #10B981, #059669);
    color: #FFFFFF;
    box-shadow: 0 3px 8px rgba(16, 185, 129, 0.35);
    transform: translateY(-1px);
}
.has-items-dot {
    position: absolute;
    top: 1px;
    right: 3px;
    background: #EF4444;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid white;
}
.tab-add-btn, .action-btn {
    display: inline-flex;
    width: 34px;
    height: 34px;
    background: #FFFFFF;
    color: #059669;
    align-items: center;
    justify-content: center;
    border-radius: 17px;
    font-weight: bold;
    font-size: calc(1.1rem * var(--font-scale));
    flex-shrink: 0;
    border: 1px solid #E2E8F0;
    box-shadow: 0 2px 5px rgba(0,0,0,0.04);
    transition: all 0.2s;
}
.tab-add-btn {
    background: #E8EFEA;
    border: none;
}
.tab-add-btn:active, .action-btn:active {
    background: #E2E8F0;
    transform: scale(0.94);
}
button.share-btn {
    margin: 0 !important;
    padding: 0 !important;
    width: 34px !important;
    min-width: 34px !important;
    height: 34px !important;
    min-height: 34px !important;
    line-height: 34px !important;
    background-color: #FFFFFF !important;
    border-radius: 17px !important;
    border: 1px solid #E2E8F0 !important;
    box-shadow: 0 2px 5px rgba(0,0,0,0.04) !important;
}
button.share-btn::after {
    border: none;
}

/* === 左右分栏布局 === */
.main-split {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 8px;
    padding: 0 8px;
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
    overflow: hidden;
    height: calc(100vh - 110px - env(safe-area-inset-bottom));
}
.left-panel {
    width: 86px;
    flex-shrink: 0;
    min-width: 0;
    height: 100%;
}
.right-panel {
    flex: 1 1 0%;
    min-width: 0;
    width: 0;
    height: 100%;
    overflow-x: hidden;
}
.empty-invoice-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-muted);
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 20px 10px;
    border: 1px solid #E6EFE9;
}

/* === 品类网格 === */
.section-title {
    font-size: calc(1.05rem * var(--font-scale));
    font-weight: bold;
    margin: 0 0 8px 3px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.cat-section-title {
    font-size: calc(0.92rem * var(--font-scale));
    color: #334155;
}
.manage-btn {
    font-size: calc(0.85rem * var(--font-scale));
    color: var(--primary-light);
    padding: 3px;
}
.category-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 8px;
    padding-bottom: 20px;
}
.cat-btn {
    background: var(--card-bg);
    border: 1.5px solid #E2E8F0;
    border-radius: 12px;
    padding: 8px 3px;
    text-align: center;
    box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    transition: all 0.2s;
    position: relative;
}
.cat-btn.selected {
    border-color: #10B981;
    background: linear-gradient(180deg, #ECFDF5 0%, #F0FDF4 100%);
    box-shadow: 0 3px 10px rgba(16, 185, 129, 0.18);
}
.cat-name {
    font-size: calc(0.95rem * var(--font-scale));
    font-weight: bold;
    color: var(--text-main);
    margin-bottom: 2px;
}
.cat-price {
    font-size: calc(0.82rem * var(--font-scale));
    color: #059669;
    font-weight: 700;
}
.cat-unit {
    font-size: 0.68rem;
    color: #64748B;
    font-weight: normal;
}
.edit-price-icon {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 18px;
    height: 18px;
    background: rgba(5, 150, 105, 0.08);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: calc(10px * var(--font-scale));
    color: #059669;
}

/* === 键盘与输入区 (底部弹窗) === */
.bottom-sheet-overlay {
    align-items: flex-end;
}
.input-card {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding: 10px 20px 20px;
    box-shadow: var(--shadow-sm);
    width: 100%;
    margin-bottom: 0;
    padding-bottom: calc(20px + var(--safe-bottom));
    animation: slideUpBottomSheet 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.drag-handle {
    width: 40px;
    height: 5px;
    background: #CBD5E1;
    border-radius: 3px;
    margin: 0 auto 15px;
}
@keyframes slideUpBottomSheet {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

/* === 临时调价�?=== */
.temp-price-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    background: #F8FAFC;
    padding: 10px 15px;
    border-radius: var(--radius-md);
    border: 1px dashed var(--border-color);
}
.temp-price-left {
    display: flex;
    align-items: center;
}
.temp-price-label {
    font-size: calc(1rem * var(--font-scale));
    font-weight: bold;
    color: var(--text-main);
}
.temp-price-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}
.btn-price-adj {
    background: white;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: calc(0.95rem * var(--font-scale));
    color: var(--primary-color);
    font-weight: bold;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}
.btn-price-adj:active {
    background: var(--primary-light);
    color: white;
    border-color: var(--primary-light);
}
.temp-price-val {
    font-size: calc(1.25rem * var(--font-scale));
    font-weight: bold;
    color: var(--accent-color);
    padding: 0 5px;
}
.temp-price-val:active {
    opacity: 0.7;
}

.input-display {
    background: #F8FAFC;
    border-radius: var(--radius-md);
    padding: 15px;
    margin-bottom: 15px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    min-height: 90px;
}
.input-right {
    flex: 1;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 0;
}
.clear-history {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding-right: 10px;
    flex-shrink: 0;
    max-width: 140px;
}
.restore-btn {
    color: var(--primary-color);
    font-size: calc(0.9rem * var(--font-scale));
    padding: 4px 8px;
    background: rgba(46,204,113,0.1);
    border-radius: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border: 1px dashed rgba(46,204,113,0.5);
}
.restore-btn:active {
    background: rgba(46,204,113,0.2);
}
.formula-text {
    font-size: calc(1.2rem * var(--font-scale));
    color: var(--text-muted);
    min-height: 1.5rem;
    margin-bottom: 5px;
    word-break: break-all;
}
.result-text {
    font-size: calc(2.2rem * var(--font-scale));
    font-weight: bold;
    color: var(--primary-color);
}
.keyboard {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}
.key-btn {
    background: #F1F5F9;
    border-radius: var(--radius-md);
    font-size: calc(1.6rem * var(--font-scale));
    font-weight: 500;
    color: var(--text-main);
    padding: 16px 0;
    box-shadow: 0 2px 0 rgba(0,0,0,0.05);
    text-align: center;
}
.key-btn-active {
    background: #E2E8F0;
    transform: translateY(2px);
    box-shadow: none;
}
.key-action {
    background: #E2E8F0;
    color: var(--text-main);
}
.key-enter {
    background: var(--primary-color);
    color: white;
    font-size: calc(1.3rem * var(--font-scale));
    grid-column: span 4;
    height: 100%;
    padding: 18px 0;
}
.key-enter-active {
    background: var(--primary-light);
}

/* === 当前清单 === */
.invoice-card {
    background: var(--card-bg);
    border-radius: 14px;
    padding: 10px 10px 12px 10px;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.07);
    border: 1px solid #E6EFE9;
    margin-bottom: 16px;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
}
.invoice-card-title {
    font-size: calc(0.98rem * var(--font-scale));
    font-weight: bold;
    color: #1E293B;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 6px 0;
}
.invoice-count-badge {
    font-size: 0.72rem;
    color: #059669;
    background: #ECFDF5;
    padding: 1px 6px;
    border-radius: 10px;
    font-weight: 600;
}
.invoice-list {
    margin-bottom: 6px;
    max-height: 200px;
}
.invoice-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px dashed #E2E8F0;
}
.invoice-item:last-child {
    border-bottom: none;
}
.item-info {
    display: flex;
    flex-direction: column;
    flex: 1 1 0%;
    min-width: 0;
}
.item-name {
    font-size: calc(0.92rem * var(--font-scale));
    font-weight: 600;
    color: #1E293B;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    align-items: baseline;
    gap: 4px;
}
.item-unit-price {
    font-size: 0.72rem;
    color: #059669;
    font-weight: normal;
}
.item-detail {
    font-size: calc(0.78rem * var(--font-scale));
    color: #64748B;
    margin-top: 2px;
    display: flex;
    align-items: center;
}
.item-weight-val {
    font-weight: 600;
    color: #334155;
}
.item-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    margin-left: 6px;
}
.item-total {
    font-size: calc(1.02rem * var(--font-scale));
    font-weight: bold;
    color: #0F172A;
}
.btn-del-item {
    background: #FEE2E2;
    color: #EF4444;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: bold;
    transition: all 0.2s;
}
.btn-del-item:active {
    background: #FCA5A5;
    transform: scale(0.9);
}
.invoice-summary {
    border-top: 1px solid #EAEFEA;
    padding-top: 8px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 10px;
}
.sum-left {
    display: flex;
    flex-direction: column;
}
.sum-label {
    font-size: calc(0.88rem * var(--font-scale));
    font-weight: 600;
    color: #475569;
}
.sum-discount-tag {
    font-size: 0.72rem;
    color: #EF4444;
    margin-top: 2px;
}
.sum-value {
    font-size: calc(1.4rem * var(--font-scale));
    font-weight: 800;
    color: #059669;
    line-height: 1.1;
}
.sum-currency {
    font-size: 0.95rem;
    margin-right: 1px;
}
.btn-settle {
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: #FFFFFF;
    width: 100%;
    padding: 11px 8px;
    border-radius: 22px;
    font-size: calc(1.02rem * var(--font-scale));
    font-weight: bold;
    text-align: center;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
    box-sizing: border-box;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.5px;
    transition: all 0.2s;
}
.btn-settle-active {
    transform: scale(0.98);
    opacity: 0.92;
}

/* === 历史记录�?=== */
.history-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}
.history-card {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: var(--shadow-sm);
    border-left: 5px solid var(--primary-color);
}
.history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px;
}
.history-time {
    font-size: calc(0.95rem * var(--font-scale));
    color: var(--text-muted);
    font-weight: 500;
}
.history-total {
    font-size: calc(1.3rem * var(--font-scale));
    font-weight: bold;
    color: var(--accent-color);
}
.history-items {
    font-size: calc(0.95rem * var(--font-scale));
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 12px;
}
.history-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}
.btn-history-action {
    background: #F1F5F9;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: calc(0.9rem * var(--font-scale));
    color: var(--text-main);
    font-weight: 500;
}
.btn-history-receipt {
    background: #E0F2FE;
    color: #0369A1;
    border: 1px solid #BAE6FD;
}
.btn-history-receipt:active {
    background: #BAE6FD;
}
.btn-history-copy {
    background: #E8F5E9;
    color: #2E7D32;
}
.btn-history-undo {
    background: var(--danger-light);
    color: var(--danger-color);
}

/* === 底部导航 === */
.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    display: flex;
    box-shadow: 0 -2px 12px rgba(16, 185, 129, 0.06);
    border-top: 1px solid #EAEFEA;
    padding-bottom: env(safe-area-inset-bottom, 16px);
    z-index: 100;
}
.nav-item {
    flex: 1;
    text-align: center;
    padding: 8px 0;
    color: #64748B;
    font-size: calc(0.85rem * var(--font-scale));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    transition: all 0.2s;
}
.nav-item.active {
    color: #059669;
    font-weight: 700;
}
.nav-icon {
    font-size: calc(1.3rem * var(--font-scale));
}

.settings-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid var(--border-color);
}
.settings-row:last-child {
    border-bottom: none;
}
.settings-label {
    font-size: calc(1.1rem * var(--font-scale));
    font-weight: bold;
    color: var(--text-main);
}
.settings-controls {
    display: flex;
    gap: 10px;
    align-items: center;
}
.unit-toggle-new {
    background: #F1F5F9;
    border-radius: 20px;
    display: flex;
    padding: 4px;
}
.unit-toggle-new .unit-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 6px 16px;
    border-radius: 16px;
    font-size: calc(0.95rem * var(--font-scale));
    transition: all 0.3s;
}
.unit-toggle-new .unit-btn.active {
    background: white;
    color: var(--primary-color);
    font-weight: bold;
    box-shadow: var(--shadow-sm);
}

/* === 弹窗 === */
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.modal-overlay.active {
    animation: fadeIn 0.2s;
}
.modal-card {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 400px;
    padding: 24px;
    box-shadow: var(--shadow-md);
    animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes slideUp {
    from { transform: translateY(30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
.modal-title {
    font-size: calc(1.3rem * var(--font-scale));
    font-weight: bold;
    margin-bottom: 20px;
    text-align: center;
}
.modal-input {
    width: 100%;
    height: 50px;
    font-size: calc(1.5rem * var(--font-scale));
    padding: 0 12px;
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    text-align: center;
    margin-bottom: 20px;
    box-sizing: border-box;
}
.modal-actions {
    display: flex;
    gap: 15px;
}
.modal-btn {
    flex: 1;
    padding: 14px;
    border-radius: var(--radius-md);
    font-size: calc(1.1rem * var(--font-scale));
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}
.modal-btn-cancel {
    background: #F1F5F9;
    color: var(--text-main);
}
.modal-btn-danger {
    background: var(--danger-color);
    color: white;
}
.modal-btn-confirm {
    background: var(--primary-color);
    color: white;
}

/* === 云端同步 Loading === */
.cloud-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255,255,255,0.9);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.loading-spinner {
    width: 50px;
    height: 50px;
    border: 5px solid #f3f3f3;
    border-top: 5px solid var(--primary-color);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 20px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.loading-text {
    font-size: 1.1rem;
    color: var(--text-color);
    font-weight: 500;
}

/* === 新手引导教程样式 === */
.guide-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: transparent;
    z-index: 9990;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none; /* 容器不拦截，由 mask 面板拦截点击 */
}
.guide-overlay.active {
    opacity: 1;
}
/* 兜底全屏遮罩：目标元素 rect 尚未算出时显示，避免初始无遮罩 */
.guide-mask-full {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 9990;
    pointer-events: auto;
}
/* 4 块拼接半透明遮罩，中间镂空高亮区 */
.guide-mask-panel {
    position: fixed;
    background: rgba(0, 0, 0, 0.65);
    z-index: 9990;
    pointer-events: auto;
}
.guide-highlight {
    position: fixed;
    z-index: 9991;
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
    border: 2px dashed var(--accent-color);
    box-sizing: border-box;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.4); /* 仅高亮框外发光，挖洞由 4 块拼接负责 */
}
.guide-tooltip {
    position: fixed;
    z-index: 9992;
    background: var(--card-bg);
    color: var(--text-main);
    padding: 16px 20px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md), 0 10px 30px rgba(0,0,0,0.15);
    width: 290px;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    font-size: calc(0.95rem * var(--font-scale));
    box-sizing: border-box;
    transform: scale(0.95);
    opacity: 0;
    pointer-events: auto; /* 显式恢复气泡内部的点击响应 */
}
.guide-overlay.active .guide-tooltip {
    transform: scale(1);
    opacity: 1;
}
.guide-tooltip-title {
    font-weight: bold;
    font-size: calc(1.1rem * var(--font-scale));
    margin-bottom: 8px;
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.guide-voice-btn {
    font-size: calc(1.2rem * var(--font-scale));
    padding: 2px 6px;
    background: #F1F5F9;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.guide-voice-btn:active {
    background: #E2E8F0;
}
.guide-tooltip-content {
    line-height: 1.5;
    margin-bottom: 15px;
    color: var(--text-main);
}
.guide-tooltip-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.guide-btn {
    padding: 8px 14px;
    border-radius: 20px;
    font-size: calc(0.85rem * var(--font-scale));
    font-weight: bold;
    text-align: center;
    transition: all 0.2s;
}
.guide-btn-primary {
    background: var(--primary-color);
    color: white;
}
.guide-btn-primary:active {
    background: var(--primary-light);
}
.guide-btn-text {
    color: var(--text-muted);
}
.guide-btn-text:active {
    background: #F1F5F9;
}
.guide-step-indicator {
    font-size: calc(0.85rem * var(--font-scale));
    color: var(--text-muted);
    font-weight: 500;
}

/* === 设置弹窗新增字段样式 === */
.settings-input-field {
    width: 100%;
    height: 42px;
    background: #F8FAFC;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0 12px;
    font-size: calc(0.95rem * var(--font-scale));
    color: var(--text-main);
    box-sizing: border-box;
}

/* === 电子小票弹窗与画布样式 === */
.receipt-modal-overlay {
    padding: 16px 12px;
    z-index: 10000;
}
.receipt-modal-card {
    background: #FFFFFF;
    border-radius: 20px;
    width: 100%;
    max-width: 380px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    padding: 18px 16px 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
    animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-sizing: border-box;
}
.receipt-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}
.receipt-title-box {
    display: flex;
    align-items: center;
    gap: 6px;
}
.receipt-title-icon {
    font-size: 1.3rem;
}
.receipt-title-text {
    font-size: calc(1.15rem * var(--font-scale));
    font-weight: bold;
    color: var(--primary-color);
}
.receipt-modal-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #F1F5F9;
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: bold;
}
.receipt-modal-close:active {
    background: #E2E8F0;
}
.receipt-sub-tip {
    font-size: calc(0.8rem * var(--font-scale));
    color: #047857;
    background: #ECFDF5;
    padding: 6px 10px;
    border-radius: 8px;
    margin-bottom: 12px;
    text-align: center;
}
.receipt-scroll-container {
    flex: 1;
    max-height: 56vh;
    overflow-y: auto;
    border-radius: 12px;
    background: #F1F5F9;
    padding: 12px 10px;
    box-sizing: border-box;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.06);
}
.receipt-paper-wrapper {
    display: flex;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(0,0,0,0.12);
    border-radius: 4px;
    overflow: hidden;
    background: #FFFFFF;
}
.receipt-preview-img {
    width: 100%;
    display: block;
}
.receipt-modal-footer {
    display: flex;
    gap: 8px;
    margin-top: 14px;
}
.receipt-btn {
    flex: 1;
    height: 44px;
    line-height: 44px;
    border-radius: 22px;
    font-size: calc(0.85rem * var(--font-scale));
    font-weight: bold;
    text-align: center;
    padding: 0 6px;
    margin: 0;
    border: none;
    box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
}
.receipt-btn::after {
    border: none;
}
.receipt-btn-preview {
    background: #F1F5F9;
    color: var(--text-main);
    border: 1px solid #CBD5E1;
}
.receipt-btn-preview:active {
    background: #E2E8F0;
}
.receipt-btn-save {
    background: var(--primary-color);
    color: #FFFFFF;
}
.receipt-btn-save:active {
    background: var(--primary-light);
}
.receipt-btn-share {
    background: #10B981;
    color: #FFFFFF;
}
.receipt-btn-share:active {
    background: #059669;
}
.receipt-offscreen-canvas {
    position: fixed;
    left: -9999px;
    top: -9999px;
    pointer-events: none;
    opacity: 0;
}

/* === 顶部收款码快捷按钮 === */
.pay-qr-nav-btn {
    font-size: 1.15rem;
    background: #E8F5E9;
    border: 1px solid #C8E6C9;
}

/* === 清单皮重标签 === */
.item-tare-tag {
    font-size: 0.78rem;
    color: #E67E22;
    background: #FEF9E7;
    padding: 1px 4px;
    border-radius: 4px;
    margin: 0 3px;
}

/* === 抹零折让快捷条 === */
.discount-bar {
    display: flex;
    align-items: center;
    padding: 4px 6px;
    background: #F0FDF4;
    border: 1px solid #DCFCE7;
    border-radius: 8px;
    margin: 6px 0 8px 0;
    gap: 4px;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
}
.discount-title {
    font-size: calc(0.72rem * var(--font-scale));
    color: #059669;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
}
.discount-scroll {
    display: flex;
    gap: 4px;
    flex: 1 1 0%;
    min-width: 0;
    width: 0;
    overflow-x: auto;
}
.discount-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
}
.discount-chip {
    font-size: calc(0.72rem * var(--font-scale));
    padding: 2px 7px;
    border-radius: 6px;
    background: #FFFFFF;
    border: 1px solid #D1FAE5;
    color: #374151;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.15s;
}
.discount-chip.active {
    background: linear-gradient(135deg, #10B981, #059669);
    color: #FFFFFF;
    border-color: transparent;
    font-weight: bold;
    box-shadow: 0 2px 6px rgba(16, 185, 129, 0.25);
}
.sum-left {
    display: flex;
    flex-direction: column;
}
.sum-discount-tag {
    font-size: 0.75rem;
    color: #E74C3C;
    margin-top: 2px;
}

/* === 智能去皮 (Tare) 快捷栏 === */
.tare-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    background: #FFFDF0;
    border: 1px dashed #F39C12;
    border-radius: 10px;
    margin-bottom: 8px;
}
.tare-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: calc(0.82rem * var(--font-scale));
    color: #D35400;
    font-weight: 600;
}
.tare-val-tag {
    background: #E74C3C;
    color: #FFFFFF;
    font-size: 0.72rem;
    padding: 1px 5px;
    border-radius: 10px;
}
.tare-chips {
    display: flex;
    gap: 6px;
}
.tare-chip {
    font-size: calc(0.78rem * var(--font-scale));
    padding: 3px 8px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    color: var(--text-main);
    transition: all 0.2s;
}
.tare-chip.active {
    background: #E67E22;
    border-color: #E67E22;
    color: #FFFFFF;
    font-weight: bold;
}
.tare-calc-hint {
    font-size: 0.82rem;
    color: #E67E22;
    font-weight: normal;
}
.net-tag {
    font-size: 0.9rem;
    color: var(--accent-color);
    font-weight: normal;
}

/* === 今日日结战报与分类汇总看板 === */
.today-report-action {
    margin-top: 14px;
}
.btn-copy-report {
    background: linear-gradient(135deg, #10B981, #059669);
    color: #FFFFFF;
    text-align: center;
    padding: 12px;
    border-radius: 12px;
    font-size: calc(0.95rem * var(--font-scale));
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
}
.btn-copy-report:active {
    opacity: 0.9;
    transform: scale(0.99);
}

.today-summary-box {
    margin-top: 15px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    overflow: hidden;
}
.today-summary-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: #EDF2F7;
    cursor: pointer;
}
.today-summary-title {
    font-size: calc(0.9rem * var(--font-scale));
    font-weight: bold;
    color: var(--text-main);
}
.today-summary-arrow {
    font-size: 0.8rem;
    color: var(--text-muted);
}
.today-summary-content {
    padding: 6px 12px 10px;
}
.summary-table-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px dashed #E2E8F0;
    font-size: calc(0.85rem * var(--font-scale));
}
.summary-table-row:last-child {
    border-bottom: none;
}
.summary-header-row {
    font-weight: bold;
    color: var(--text-muted);
    border-bottom: 1px solid #CBD5E1;
}
.st-cell {
    text-align: center;
}
.st-name { flex: 2; text-align: left; }
.st-weight { flex: 2; }
.st-price { flex: 1.5; color: var(--text-muted); }
.st-money { flex: 2; text-align: right; font-weight: bold; color: var(--primary-color); }

.btn-history-reuse {
    background: #FEF3C7;
    color: #B45309;
    border: 1px solid #FDE68A;
}
.btn-history-reuse:active {
    background: #FDE68A;
}

/* === 老板收款码弹窗 === */
.pay-qr-overlay {
    z-index: 10000;
}
.pay-qr-card {
    background: #FFFFFF;
    border-radius: 20px;
    width: 320px;
    max-width: 90vw;
    padding: 20px;
    box-shadow: var(--shadow-md);
    animation: slideUp 0.25s ease-out;
    text-align: center;
}
.pay-qr-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}
.pay-qr-title {
    font-size: calc(1.15rem * var(--font-scale));
    font-weight: bold;
    color: var(--primary-color);
}
.pay-qr-close {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #F1F5F9;
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
}
.pay-qr-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
}
.pay-qr-image {
    width: 240px;
    height: 240px;
    border-radius: 12px;
    border: 1px solid #E2E8F0;
    margin-bottom: 10px;
}
.pay-qr-hint {
    font-size: 0.85rem;
    color: var(--text-muted);
}
.pay-qr-empty {
    border: 2px dashed #CBD5E1;
    border-radius: 16px;
    padding: 30px 16px;
    background: #F8FAFC;
    cursor: pointer;
}
.pay-qr-empty:active {
    background: #F1F5F9;
}
.pay-qr-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}
.pay-qr-action-btn {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    background: #F1F5F9;
    color: var(--text-main);
    text-align: center;
}
.pay-qr-action-btn.delete-btn {
    color: var(--danger-color);
    background: var(--danger-light);
}

