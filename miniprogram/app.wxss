page {
  --primary-color: #059669;
  --primary-light: #10B981;
  --accent-color: #10B981;
  --danger-color: #EF4444;
  --danger-light: #FEF2F2;
  --bg-color: #F4F8F5;
  --card-bg: #FFFFFF;
  --text-main: #1E293B;
  --text-muted: #64748B;
  --border-color: #E2E8F0;
  --radius-md: 12px;
  --radius-lg: 16px;
  --shadow-sm: 0 2px 8px rgba(16, 185, 129, 0.06);
  --shadow-md: 0 4px 14px rgba(16, 185, 129, 0.12);
  --safe-bottom: env(safe-area-inset-bottom, 20px);

  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-main);
  line-height: 1.5;
  width: 100vw;
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

view, text, button {
  box-sizing: border-box;
}

::-webkit-scrollbar {
  width: 0px;
  height: 0px;
}
